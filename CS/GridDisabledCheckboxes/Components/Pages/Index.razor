@page "/"
@using GridDisabledCheckboxes.Services
@inject WeatherForecastService ForecastService

<DxGrid @ref="Grid"
        Data="@forecasts"
        CssClass="mw-1100"
        SelectedDataItems="@SelectedDataItems"
        SelectedDataItemsChanged="OnSelectedDataItemsChanged">
    <Columns>
        <DxGridSelectionColumn Width="70px" AllowSelectAll="true">
            <HeaderTemplate>
                <DxCheckBox Checked="SelectedStatus"
                            CheckedChanged="@((Selected value) => CheckedChanged(value))"
                            AllowIndeterminateStateByClick="false"
                            ValueChecked="@Selected.All"
                            ValueUnchecked="@Selected.None"
                            ValueIndeterminate="@Selected.Some" />
            </HeaderTemplate>
            <CellDisplayTemplate>
                @{
                    var item = (WeatherForecast)context.DataItem;
                }
                <DxCheckBox @bind-Checked="context.Selected" Enabled=@(item.Summary != "Mild") />
            </CellDisplayTemplate>
        </DxGridSelectionColumn>
        <DxGridDataColumn Caption="Date" FieldName="Date" />
        <DxGridDataColumn Caption="Temperature" FieldName="TemperatureF" />
        <DxGridDataColumn Caption="Summary" FieldName="Summary" />
    </Columns>
</DxGrid>

@code {
    private enum Selected { All, None, Some }

    private IGrid Grid { get; set; }
    private Selected SelectedStatus { get; set; }

    private WeatherForecast[]? forecasts;
    private IReadOnlyList<object> SelectedDataItems;

    protected override async Task OnInitializedAsync() {
        forecasts = await ForecastService.GetForecastAsync(DateOnly.FromDateTime(DateTime.Now));
        SelectedDataItems = forecasts.Where(f => f.Summary == "Warm").ToList();
        UpdateSelectedStatus(SelectedDataItems.OfType<WeatherForecast>().ToList());
    }

    private void CheckedChanged(Selected value) {
        var gridItems = forecasts.Where(item => item.Summary != "Mild").ToList();

        switch (value) {
            case Selected.All:
                SelectedDataItems = gridItems;
                break;
            case Selected.None:
                SelectedDataItems = new List<object>();
                break;
        }

        SelectedStatus = value;
    }

    private void OnSelectedDataItemsChanged(IReadOnlyList<object> newSelection) {
        var selectedItems = newSelection
            .OfType<WeatherForecast>()
            .Where(item => item.Summary != "Mild")
            .ToList();
        UpdateSelectedStatus(selectedItems);
    }

    private void UpdateSelectedStatus(List<WeatherForecast> selectedItems)  {
        var gridItems = forecasts.Where(item => item.Summary != "Mild").ToList();
        var areEqual = new HashSet<WeatherForecast>(gridItems).SetEquals(selectedItems.OfType<WeatherForecast>());

        if (selectedItems.Count == 0) {
            SelectedStatus = Selected.None;
        }
        else if (areEqual) {
            SelectedStatus = Selected.All;
        }
        else {
            SelectedStatus = Selected.Some;
        }
    }
}
